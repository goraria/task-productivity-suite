# Next.js Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3034
NEXT_PUBLIC_AUTH_URL=https://gorth-auth.vercel.app
# Must be a confidential SSO client supporting code + refresh + client_credentials with PKCE.
NEXT_OAUTH_CLIENT_ID=<confidential-client-id-from-sso>
NEXT_OAUTH_COOKIE_PREFIX=gorth

NEXT_OAUTH_AUDIENCE=http://localhost:3034

NEXT_OAUTH_NOTIFY_AUDIENCE=http://localhost:5052
NEXT_OAUTH_RESOURCE_AUDIENCE=http://localhost:5053
NEXT_OAUTH_DISCOVERY_AUDIENCE=http://localhost:5054
# Grant these existing resource audiences to the app in SSO before using them.
NEXT_OAUTH_PAYMENT_AUDIENCE=http://localhost:5055
NEXT_OAUTH_BILLING_AUDIENCE=http://localhost:5056
NEXT_OAUTH_MEDIA_AUDIENCE=http://localhost:5057
NEXT_OAUTH_INSIGHT_AUDIENCE=http://localhost:5058

NEXT_SESSION_SECRET=
NEXT_SESSION_MAX_AGE_SECONDS=2592000
DATABASE_URL=
# Same confidential identity for genericOAuth sign-in and scoped backend grants. Secret stays server-only.
NEXT_OAUTH_CLIENT_SECRET=
# Match the existing client registration; basic or post, no client rotation.
# Private Task storage credentials; consumed only by the authenticated internal endpoint.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
# Schedule authenticated /task/resource-policy/dispatch at least every minute.
PG_POOL_MAX=5

# Persistent DB-backed rate limit. Tune the deployment policy before enabling.
RATE_LIMIT_ENABLED=false

# Vercel Cron recovery only; use an independent random secret.
CRON_SECRET=
# Set automatically by Vercel. Leave blank locally.
VERCEL=
# Keep external OTLP exporters unset; telemetry policy disables export if configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
